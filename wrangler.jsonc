{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alerts-api",
  "main": "worker/proxy.js",
  "compatibility_date": "2026-06-15",
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/citymetro/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
